{
  "schemaVersion": 1,
  "assetRoot": "..",
  "capabilities": {
    "provided": ["controlled-execution@1", "execution-profile@1"],
    "unsupported": [
      "filesystem-trace@1",
      "filesystem-fault-injection@1",
      "returned-byte-observation@1",
      "network-denial@1",
      "network-attempt-observation@1",
      "external-file-access-observation@1"
    ]
  },
  "bindings": {
    "runner": "bin/mdlm-phase1-qualify.mjs",
    "configuration": "config/qualification.json",
    "fixtures": ["fixtures/calculator.mjs", "fixtures/temperature.mjs", "fixtures/nonconforming.mjs"],
    "oracles": ["lib/oracles.mjs"],
    "probes": ["probes/node24.mjs", "probes/raw-streams.mjs"],
    "profiles": ["profiles/calculator.json", "profiles/temperature.json"]
  },
  "deadlineMs": 2000,
  "termGraceMs": 100,
  "probes": [
    { "id": "node24", "path": "probes/node24.mjs", "argv": [], "expected": { "status": 0, "stdoutBase64": "bm9kZTI0Cg==", "stderrBase64": "" } },
    { "id": "raw-streams", "path": "probes/raw-streams.mjs", "argv": [], "expected": { "status": 23, "stdoutBase64": "AP8=", "stderrBase64": "/gE=" } }
  ],
  "fixtureSuites": [
    {
      "id": "calculator",
      "fixture": "fixtures/calculator.mjs",
      "oracle": "calculator",
      "cases": [
        { "id": "exact-decimal", "argv": ["0.1", "+", "0.2"] },
        { "id": "rounding", "argv": ["2", "/", "3"] },
        { "id": "malformed", "argv": ["1e2", "+", "2"] },
        { "id": "omitted", "argv": ["1", "+"] },
        { "id": "empty", "argv": ["", "+", "2"] },
        { "id": "extra", "argv": ["1", "+", "2", "extra"] }
      ]
    },
    {
      "id": "temperature",
      "fixture": "fixtures/temperature.mjs",
      "oracle": "temperature",
      "cases": [
        { "id": "freezing", "argv": ["0", "C", "F"] },
        { "id": "absolute-zero", "argv": ["-459.67", "F", "K"] },
        { "id": "below-absolute-zero", "argv": ["-273.150000000001", "C", "K"] },
        { "id": "malformed", "argv": ["NaN", "C", "F"] },
        { "id": "omitted", "argv": ["0", "C"] },
        { "id": "extra", "argv": ["0", "C", "F", "extra"] }
      ]
    }
  ],
  "negativeControls": [
    { "id": "calculator-wrong-result", "fixture": "fixtures/nonconforming.mjs", "oracle": "calculator", "argv": ["1", "+", "2"] },
    { "id": "temperature-wrong-result", "fixture": "fixtures/nonconforming.mjs", "oracle": "temperature", "argv": ["0", "C", "F"] }
  ]
}
